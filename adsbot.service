[Unit]
Description=AdsBot Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/toxic/AdsBot
ExecStart=/usr/bin/python3 -m bot
Restart=always
RestartSec=5
StandardOutput=append:/home/toxic/AdsBot/adsbot.log
StandardError=append:/home/toxic/AdsBot/adsbot.log

[Install]
WantedBy=multi-user.target
